@using ServiceContracts.DTO
@model IEnumerable<PersonResponse>
@{
    Layout = null; // 生成 PDF 时不需要网页的导航栏
    var persons = Model ?? Enumerable.Empty<PersonResponse>();
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <title>人员信息报表</title>
    <style>
        /* 纸张尺寸与页边距不在这里声明：Razor 会把行首的 at-page 规则当成指令解析，
           页边距请交给生成 PDF 的库配置 */
        body {
            font-family: "Microsoft YaHei", "SimSun", Arial, sans-serif;
            font-size: 12px;
            color: #222;
            padding: 0 4px;
        }

        h1 {
            font-size: 18px;
            font-weight: 500;
            text-align: center;
            margin: 0 0 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #888;
            padding: 6px 8px;
            text-align: left;
            vertical-align: top;
        }

        thead th {
            background: #f1efe8;
            font-weight: 500;
        }

        tbody tr:nth-child(even) {
            background: #fafafa;
        }

        td.date {
            white-space: nowrap;
        }

        p.empty {
            text-align: center;
            color: #666;
            padding: 20px 0;
        }
    </style>
</head>
<body>
    <h1>人员信息报表</h1>

    @if (persons.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>姓名</th>
                    <th>邮箱</th>
                    <th>生日</th>
                </tr>
            </thead>
            <tbody>
                @foreach (PersonResponse person in persons)
                {
                    <tr>
                        <td>@person.PersonName</td>
                        <td>@(person.Email ?? "-")</td>
                        <td class="date">@(person.DateOfBirth?.ToString("yyyy-MM-dd") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty">暂无人员数据</p>
    }
</body>
</html>
